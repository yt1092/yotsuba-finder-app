  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs && node scripts/make-licenses.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/copy-ort.mjs && node scripts/make-licenses.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check:no-debug": "node scripts/check-no-debug.mjs",
    "check:no-diag": "node scripts/check-no-diag.mjs",
    "test:e2e": "node tests-e2e/network-offline.mjs && node tests-e2e/gacha-leave.mjs && node tests-e2e/gacha-dit.mjs && node tests-e2e/scan-crash.mjs && node tests-e2e/data-protection.mjs && node tests-e2e/crop-record.mjs && node tests-e2e/gacha-list.mjs && node tests-e2e/gacha-ready.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@fontsource/klee-one": "5.3.1",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/zen-maru-gothic": "5.3.0",
    "onnxruntime-web": "1.30.0"
  }
